{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joewangxxx/Novel2Script/schemas/story_map.schema.json",
  "title": "Novel2Script Story Map",
  "type": "object",
  "required": [
    "story_map"
  ],
  "additionalProperties": false,
  "properties": {
    "story_map": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "chapters",
        "characters_detected",
        "locations_detected",
        "props_detected",
        "key_events",
        "timeline",
        "psychological_passages",
        "uncertainties"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "characters_detected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detected_character"
          }
        },
        "locations_detected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detected_location"
          }
        },
        "props_detected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detected_prop"
          }
        },
        "key_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key_event"
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeline_item"
          }
        },
        "psychological_passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/psychological_passage"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uncertainty"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "type",
        "input_file",
        "chapter_count",
        "trace_unit"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "novel"
        },
        "input_file": {
          "type": "string"
        },
        "chapter_count": {
          "type": "integer",
          "minimum": 1
        },
        "trace_unit": {
          "type": "string",
          "const": "chapter_paragraph"
        },
        "parser_profile": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        }
      }
    },
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "index",
        "title",
        "source_heading",
        "paragraphs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ch_[0-9]{3}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "source_heading": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "required": [
        "id",
        "index",
        "text_preview"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p_[0-9]{3}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "text_preview": {
          "type": "string"
        },
        "char_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_trace": {
      "type": "object",
      "required": [
        "chapter_id",
        "paragraph_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^ch_[0-9]{3}$"
        },
        "paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^p_[0-9]{3}$"
          }
        },
        "quote_preview": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "detected_character": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_trace",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^char_[0-9]{3}$"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description_hint": {
          "type": "string"
        },
        "first_seen": {
          "$ref": "#/$defs/source_trace"
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "detected_location": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_trace",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^loc_[0-9]{3}$"
        },
        "name": {
          "type": "string"
        },
        "location_type": {
          "type": "string"
        },
        "description_hint": {
          "type": "string"
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "detected_prop": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_trace",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prop_[0-9]{3}$"
        },
        "name": {
          "type": "string"
        },
        "prop_type": {
          "type": "string"
        },
        "description_hint": {
          "type": "string"
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "key_event": {
      "type": "object",
      "required": [
        "id",
        "sequence_index",
        "summary",
        "source_trace",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evt_[0-9]{3}$"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^char_[0-9]{3}$"
          }
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^loc_[0-9]{3}$"
          }
        },
        "prop_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^prop_[0-9]{3}$"
          }
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "uncertainty_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^unc_[0-9]{3}$"
          }
        }
      }
    },
    "timeline_item": {
      "type": "object",
      "required": [
        "id",
        "order",
        "label",
        "source_trace",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tl_[0-9]{3}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string"
        },
        "time_text": {
          "type": "string"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{3}$"
          }
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "psychological_passage": {
      "type": "object",
      "required": [
        "id",
        "summary",
        "source_trace",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^psy_[0-9]{3}$"
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^char_[0-9]{3}$"
          }
        },
        "passage_type": {
          "type": "string",
          "enum": [
            "emotion",
            "memory",
            "motivation",
            "fear",
            "desire",
            "other"
          ]
        },
        "summary": {
          "type": "string"
        },
        "externalization_hint": {
          "type": "string"
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "id",
        "category",
        "description",
        "source_trace",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^unc_[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "ambiguous_character",
            "ambiguous_location",
            "ambiguous_time",
            "ambiguous_event",
            "implicit_causality",
            "pronoun_resolution",
            "parser_limitation",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "source_trace": {
          "$ref": "#/$defs/source_trace"
        },
        "suggested_resolution": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
