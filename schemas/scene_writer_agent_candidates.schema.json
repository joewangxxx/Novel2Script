{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel2script.local/schemas/scene_writer_agent_candidates.schema.json",
  "title": "Novel2Script Scene Writer Agent Candidates",
  "type": "object",
  "required": ["scene_writer_agent_candidates"],
  "additionalProperties": false,
  "properties": {
    "scene_writer_agent_candidates": {
      "type": "object",
      "required": ["schema_version", "agent_id", "provider_profile", "dry_run", "human_approval_required", "source_artifacts", "candidates", "errors", "metadata"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "agent_id": {"const": "scene_writer_agent"},
        "provider_profile": {"enum": ["kimi_creative", "mock_dry_run"]},
        "dry_run": {"type": "boolean"},
        "human_approval_required": {"const": true},
        "source_artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "type", "target", "proposed_text", "rationale", "source_trace", "source_trace_ids", "ai_tags", "constraints_observed", "risks", "confidence", "merge_policy", "requires_author_approval"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["scene_action", "visual_beat", "element_insert", "element_rewrite", "transition", "reviewer_note"]},
        "target": {"$ref": "#/$defs/target"},
        "proposed_text": {"type": "string", "minLength": 1},
        "proposed_change": {"type": "object", "additionalProperties": true},
        "rationale": {"type": "string", "minLength": 1},
        "source_trace": {"oneOf": [{"type": "object"}, {"type": "array"}]},
        "source_trace_ids": {"type": "object", "minProperties": 1},
        "ai_tags": {"$ref": "#/$defs/ai_tags"},
        "constraints_observed": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["low", "medium", "high"]},
        "merge_policy": {"const": "human_approval_required"},
        "requires_author_approval": {"const": true}
      }
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "artifact": {"type": "string"},
        "path": {"type": "string"},
        "scene_id": {"type": "string"},
        "beat_id": {"type": "string"},
        "element_id": {"type": "string"},
        "character_id": {"type": "string"}
      }
    },
    "ai_tags": {
      "type": "object",
      "required": ["inferred", "confidence", "needs_human_review"],
      "additionalProperties": false,
      "properties": {
        "inferred": {"type": "boolean"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "needs_human_review": {"const": true},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["prompt_retained", "model_response_retained", "provider_payload_retained", "full_source_text_retained"],
      "properties": {
        "prompt_retained": {"const": false},
        "model_response_retained": {"const": false},
        "provider_payload_retained": {"const": false},
        "full_source_text_retained": {"const": false}
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"enum": ["blocking", "warning"]}
      }
    }
  }
}
