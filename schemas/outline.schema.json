{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joewangxxx/Novel2Script/schemas/outline.schema.json",
  "title": "Novel2Script Outline",
  "type": "object",
  "required": [
    "outline"
  ],
  "additionalProperties": false,
  "properties": {
    "outline": {
      "type": "object",
      "required": [
        "schema_version",
        "source_story_map",
        "logline",
        "theme_candidates",
        "act_structure",
        "scene_plan",
        "source_coverage",
        "uncertainties"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "source_story_map": {
          "$ref": "#/$defs/source_story_map"
        },
        "logline": {
          "$ref": "#/$defs/annotated_text"
        },
        "theme_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theme_candidate"
          }
        },
        "act_structure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/act"
          }
        },
        "scene_plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planned_scene"
          }
        },
        "source_coverage": {
          "$ref": "#/$defs/source_coverage"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uncertainty"
          }
        }
      }
    }
  },
  "$defs": {
    "source_story_map": {
      "type": "object",
      "required": [
        "schema_version",
        "story_map_file"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "story_map_file": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        }
      }
    },
    "source_trace": {
      "type": "object",
      "required": [
        "chapter_id",
        "paragraph_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^ch_[0-9]{3}$"
        },
        "paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^p_[0-9]{3}$"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{3}$"
          }
        },
        "quote_preview": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ai_tags": {
      "type": "object",
      "required": [
        "inferred",
        "confidence",
        "needs_human_review"
      ],
      "additionalProperties": false,
      "properties": {
        "inferred": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "annotated_text": {
      "type": "object",
      "required": [
        "text",
        "source_trace",
        "ai_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_trace"
          }
        },
        "ai_tags": {
          "$ref": "#/$defs/ai_tags"
        }
      }
    },
    "theme_candidate": {
      "type": "object",
      "required": [
        "id",
        "theme",
        "rationale",
        "source_trace",
        "ai_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^theme_[0-9]{3}$"
        },
        "theme": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "source_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_trace"
          }
        },
        "ai_tags": {
          "$ref": "#/$defs/ai_tags"
        }
      }
    },
    "act": {
      "type": "object",
      "required": [
        "id",
        "index",
        "act_type",
        "title",
        "summary",
        "source_trace",
        "ai_tags",
        "scene_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^act_[0-9]{3}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "act_type": {
          "type": "string",
          "enum": [
            "act_1",
            "act_2",
            "act_3",
            "prologue",
            "epilogue",
            "custom"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "source_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_trace"
          }
        },
        "ai_tags": {
          "$ref": "#/$defs/ai_tags"
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^osp_[0-9]{3}$"
          }
        }
      }
    },
    "planned_scene": {
      "type": "object",
      "required": [
        "id",
        "order",
        "title",
        "purpose",
        "source_event_ids",
        "source_trace",
        "ai_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^osp_[0-9]{3}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{3}$"
          }
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^char_[0-9]{3}$"
          }
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^loc_[0-9]{3}$"
          }
        },
        "source_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_trace"
          }
        },
        "ai_tags": {
          "$ref": "#/$defs/ai_tags"
        },
        "uncertainty_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^unc_[0-9]{3}$"
          }
        }
      }
    },
    "source_coverage": {
      "type": "object",
      "required": [
        "story_event_count",
        "covered_event_ids",
        "uncovered_event_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "story_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{3}$"
          }
        },
        "uncovered_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{3}$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "id",
        "category",
        "description",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^out_unc_[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "low_source_coverage",
            "weak_theme_evidence",
            "scene_merge_risk",
            "timeline_ambiguity",
            "character_motivation_gap",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "source_trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_trace"
          }
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "suggested_resolution": {
          "type": "string"
        }
      }
    }
  }
}
